# ==============================================================================
# SRI USHA VET & PET STORES — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env files to version control.

# ------------------------------------------------------------------------------
# 1. CORE DATABASE CONNECTION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL / Neon Serverless connection string with SSL enabled
DATABASE_URL="postgresql://username:password@your-database-host.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# Secure random 32+ character secret for signing sessions and JWTs
# Generate on Linux/macOS with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-hex-or-base64-random-secret"

# Canonical URL of your application (Used for OAuth callbacks and return URLs)
# In production, set to your custom domain: e.g. https://sriusha.in
AUTH_URL="http://localhost:4000"

# Application base URL for absolute links and notification links
APP_URL="http://localhost:4000"

# Node Environment
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Optional - Cash on Delivery functions without keys)
# ------------------------------------------------------------------------------
# Use rzp_test_... for sandbox testing or rzp_live_... for production
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ------------------------------------------------------------------------------
# 4. CLOUD IMAGE STORAGE (Optional - Falls back to local public/uploads in development)
# ------------------------------------------------------------------------------
# Vercel Blob Storage token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# S3 / Cloudflare R2 Compatible Storage (Alternative to Vercel Blob)
# STORAGE_PROVIDER="s3"
# S3_BUCKET_NAME="sriusha-uploads"
# S3_REGION="ap-south-1"
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your_access_key_id"
# S3_SECRET_ACCESS_KEY="your_secret_access_key"

# ------------------------------------------------------------------------------
# 5. CUSTOMER COMMUNICATIONS & NOTIFICATIONS (Optional - Operates in safe log mode)
# ------------------------------------------------------------------------------
# Email Service (SendGrid / AWS SES / Postmark)
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY=""
STORE_ALERT_EMAIL="orders@sriusha.com"

# SMS Service (Twilio / MSG91)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# WhatsApp Business API (Meta / Gupshup)
WHATSAPP_PROVIDER="meta"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
