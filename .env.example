# ==============================================================================
# SRI USHA VET & PET STORES — PRODUCTION ENVIRONMENT CONFIGURATION
# TARGET ARCHITECTURE: Cloudflare Workers + Neon + Clerk + Resend + Cloudflare R2
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env files to version control.

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE (Required)
# ------------------------------------------------------------------------------
# Primary serverless PostgreSQL connection string with SSL mode enabled.
DATABASE_URL="postgresql://username:password@your-database-host.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION & IDENTITY MANAGEMENT (Required in Production)
# ------------------------------------------------------------------------------
# Public publishable key for Clerk client SDK
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_clerk_publishable_key"

# Secret backend key for verifying Clerk session JWTs and invoking Clerk REST API
CLERK_SECRET_KEY="sk_live_your_clerk_secret_key"

# Optional: Webhook signing secret for /api/clerk/webhook
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"

# ------------------------------------------------------------------------------
# 3. RESEND TRANSACTIONAL EMAIL (Required for Live Emails / Safe Log Mode Fallback)
# ------------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"

# Verified sender email address (e.g., custom domain or Resend sandbox)
RESEND_FROM_EMAIL="Sri Usha Vet & Pet Stores <orders@yourverifieddomain.com>"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (Required for Cloud Image Uploads)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (found on Cloudflare dashboard right sidebar)
R2_ACCOUNT_ID="your_cloudflare_account_id"

# R2 API Token: Access Key ID and Secret Access Key (generated in R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2 Bucket Name
R2_BUCKET_NAME="sriusha-product-images"

# Public CDN URL for accessing uploaded images (Custom domain or r2.dev public URL)
# Example: https://images.sriushastores.in or https://pub-xxxx.r2.dev
R2_PUBLIC_URL="https://images.yourdomain.com"

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (Optional - Cash on Delivery works without keys)
# ------------------------------------------------------------------------------
# Use rzp_test_... for sandbox testing or rzp_live_... for production
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ------------------------------------------------------------------------------
# 6. RUNTIME & APPLICATION URLS
# ------------------------------------------------------------------------------
# Canonical URL of the application
AUTH_URL="https://sriushastores.in"
APP_URL="https://sriushastores.in"

# JWT Secret for fallback session signing (32+ character random string)
AUTH_SECRET="your-32-character-random-secret-key-here"

# Server Port (used during local development)
PORT=4000
NODE_ENV="production"
